# Copy this to .env and fill in values

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://your-railway-app.railway.app/auth/google/callback

# PostgreSQL (Railway provides this automatically)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Session secret (any random string)
SESSION_SECRET=change-this-to-a-random-secret-string-32chars

# Optional: restrict access to specific emails (comma-separated)
# Leave empty to allow all Google accounts
ALLOWED_EMAILS=you@gmail.com,colleague@company.com

NODE_ENV=production
